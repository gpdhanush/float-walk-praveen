NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=your_database_name

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
APP_NAME=Float Walk
LOG_LEVEL=info

# Optional Google Business Profile hours synchronization
# Keep these values on the backend only.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_BUSINESS_LOCATION_ID=accounts/your-account/locations/your-location

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_DEDUPLICATION_MINUTES=30
ANALYTICS_TRACK_ADMIN=false
ANALYTICS_PUBLIC_COUNT_ENABLED=true
ANALYTICS_RATE_LIMIT_PER_MINUTE=60
ANALYTICS_CACHE_TTL_SECONDS=60
